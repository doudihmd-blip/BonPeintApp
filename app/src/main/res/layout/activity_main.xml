<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F5F9"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Bar Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="BonPeint Pro"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#0F172A" />

            <Button
                android:id="@+id/btnReset"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="جديد / Nouveau"
                android:textSize="11sp"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnLang"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="FR | AR"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Document Type Selector -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Type de document / نوع الوثيقة"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#334155"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinnerDocType"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="10dp" />

        <!-- Painter Info (Name & Phone) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/editPainterName"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.2"
                android:hint="Nom du peintre / اسم الدهان"
                android:background="#FFFFFF"
                android:padding="10dp"
                android:textSize="14sp"
                android:layout_marginEnd="6dp" />

            <EditText
                android:id="@+id/editPainterPhone"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="N° Tél / الهاتف"
                android:inputType="phone"
                android:background="#FFFFFF"
                android:padding="10dp"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Project & Client Info -->
        <EditText
            android:id="@+id/editProject"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Projet / اسم المشروع (ex: Chantier Villa)"
            android:background="#FFFFFF"
            android:padding="10dp"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/editClient"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Destinataire / المستلم (ex: Magasin Peinture)"
            android:background="#FFFFFF"
            android:padding="10dp"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <EditText
                android:id="@+id/editCity"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Hassi Messaoud"
                android:hint="Ville / المدينة"
                android:background="#FFFFFF"
                android:padding="10dp"
                android:textSize="14sp"
                android:layout_marginEnd="6dp" />

            <EditText
                android:id="@+id/editDate"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="Date / التاريخ"
                android:background="#FFFFFF"
                android:padding="10dp"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Add Items Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ajouter une fourniture / إضافة مادة"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#334155"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/editItemName"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="2"
                android:hint="Désignation / المادة"
                android:background="#FFFFFF"
                android:padding="10dp"
                android:textSize="14sp"
                android:layout_marginEnd="6dp" />

            <EditText
                android:id="@+id/editItemQty"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="Quantité / الكمية"
                android:background="#FFFFFF"
                android:padding="10dp"
                android:textSize="14sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnAdd"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="+ Ajouter à la liste / إضافة إلى القائمة"
            android:textStyle="bold"
            android:layout_marginBottom="14dp" />

        <!-- Table Container -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Liste des articles / قائمة السلع المضافة:"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#334155"
            android:layout_marginBottom="6dp" />

        <TableLayout
            android:id="@+id/tableItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:padding="4dp"
            android:stretchColumns="1"
            android:shrinkColumns="1"
            android:layout_marginBottom="20dp" />

        <!-- Print & Share Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPrint"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:textSize="13sp"
                android:textStyle="bold"
                android:text="Imprimer / طباعة"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnGenerate"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:textSize="13sp"
                android:textStyle="bold"
                android:text="PDF / مشاركة" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
